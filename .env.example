# Copy this file to ".env" for local development (never commit .env).
# On Render, these are set automatically by render.yaml — you only type
# in the OPENAI_API_KEY value in the dashboard when prompted.

# Database — leave unset locally to use a SQLite file (smart1_sales_builder.db).
# Render fills this in automatically from the blueprint's Postgres.
# DATABASE_URL=postgresql://user:pass@host/dbname

# The existing IO app (untouched) — API for AI routes + IO conversion,
# and the app embedded in the "Insertion Orders" tab.
IO_API_BASE=https://insertionordersmart.onrender.com
IO_APP_URL=https://insertionordersmart.onrender.com

# Optional — enables "draft a proposal from one sentence", the AI section
# rewriter, and AI filenames/alt text in Tools > SEO Image Optimizer.
# Everything else works without it.
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini
OPENAI_VISION_MODEL=gpt-4o

# Optional — hosts optimized images from Tools > SEO Image Optimizer.
# Without it the tool still resizes/converts and returns a ZIP.
# Use the same value as the insertionordersmart service.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Max size for one image batch upload (MB)
MAX_UPLOAD_MB=60
